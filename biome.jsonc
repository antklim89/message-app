{
  "$schema": "node_modules/@biomejs/biome/configuration_schema.json",
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "useSortedPackageJson": "on",
        "noDuplicateClasses": "on",
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              "react*",
              "next*",
              ":BUN:",
              ":NODE:",
              ":PACKAGE:",
              ":PACKAGE_WITH_PROTOCOL:",
              ":BLANK_LINE:",
              ":ALIAS:",
              "./**",
              "../**"
            ]
          }
        }
      }
    }
  },

  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  },

  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*",
      "!**/next-env.d.ts",
      "!**/*generated.*",
      "!**/*-generated",
      "!**/node_modules/**/*",
      "!**/dist/**/*",
      "!**/out/**/*",
      "!**/build/**/*",
      "!**/migrations/**/*",
      "!**/.next/**/*",
      "!**/.turbo/**/*"
    ]
  },

  "formatter": {
    "expand": "auto",
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },

  "html": {
    "formatter": {
      "indentScriptAndStyle": true,
      "whitespaceSensitivity": "strict"
    }
  },

  "javascript": {
    "globals": ["Bun"],
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "asNeeded"
    }
  },

  "linter": {
    "enabled": true,
    "domains": {
      "drizzle": "all",
      "react": "all",
      "next": "none",
      "tailwind": "all",
      "test": "all",
      "types": "all",
      "solid": "none",
      "qwik": "none",
      "reactNative": "none",
      "tanstackQuery": "all"
    },
    "rules": {
      "a11y": {
        "preset": "all",
        "useMediaCaption": "off"
      },

      "complexity": {
        "preset": "all",
        "useMathMinMax": "error",
        "useArraySome": "error",
        "noUnnecessaryTemplateExpression": "error",
        "noExcessiveNestedCallbacks": "error",
        "noExcessiveLinesPerFunction": { "level": "error", "options": { "skipBlankLines": true, "skipIifes": true } },
        "useOptionalChain": { "fix": "safe", "level": "error" },
        "useRegexpTest": "error",
        "noVoid": "off"
      },

      "correctness": {
        "preset": "all",
        "useReactAsyncServerFunction": { "fix": "safe", "level": "error" },
        "noUnresolvedImports": "off",
        "useImportExtensions": "off",
        "noUndeclaredDependencies": "off",
        "noNodejsModules": "off",
        "noProcessGlobal": "off"
      },

      "performance": {
        "preset": "all",
        "useDomNodeTextContent": "error",
        "noBarrelFile": "off",
        "noJsxPropsBind": "off",
        "noNamespaceImport": "off"
      },

      "security": {
        "preset": "all",
        "useIframeSandbox": "error",
        "noSecrets": { "level": "error", "options": { "entropyThreshold": 50 } }
      },

      "suspicious": {
        "preset": "all",
        "noLoopFunc": "error",
        "noConsole": { "level": "warn", "options": { "allow": ["error", "warn"] } },
        "noEqualsToNull": "off",
        "noLeakedRender": "off",
        "noReactSpecificProps": "off",
        "noArrayIndexKey": "off",
        "useAwait": "off",
        "noParametersOnlyUsedInRecursion": "off"
      },

      "nursery": {
        "noFloatingPromises": "error",
        "noImpliedEval": "error",
        "noRestrictedDependencies": "error",
        "useExhaustiveSwitchCases": "error",
        "useIncludes": { "fix": "safe", "level": "error" },
        "useReactFunctionComponentDefinition": { "fix": "safe", "level": "error" }
      },

      "style": {
        "preset": "recommended",
        "noCommonJs": "error",
        "noEnum": "error",
        "noMultiAssign": "error",
        "noNegationElse": "error",
        "noParameterAssign": "error",
        "noParameterProperties": "error",
        "useReduceTypeParameter": { "fix": "safe", "level": "error" },
        "useComponentExportOnlyModules": "off",
        "useConsistentCurlyBraces": { "fix": "safe", "level": "error" },
        "useErrorCause": "off",
        "useNodejsImportProtocol": { "fix": "safe", "level": "error" },
        "useReactFunctionComponents": "error",
        "useShorthandAssign": { "fix": "safe", "level": "error" },
        "useThrowNewError": { "fix": "safe", "level": "error" },
        "useThrowOnlyError": "error",
        "useUnifiedTypeSignatures": { "fix": "safe", "level": "error" },
        "useConsistentTypeDefinitions": {
          "fix": "safe",
          "level": "error",
          "options": { "style": "interface" }
        },
        "useFilenamingConvention": {
          "level": "off",
          "options": { "filenameCases": ["kebab-case"], "requireAscii": true, "strictCase": true }
        },
        "useConsistentObjectDefinitions": {
          "level": "on",
          "fix": "safe",
          "options": { "syntax": "shorthand" }
        },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["zod", "zod/v3", "zod/v4"],
                "message": "Only zod/v4-mini import allowed."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts"],
      "linter": {
        "rules": {
          "performance": { "noAwaitInLoops": "off", "noDelete": "off" },
          "style": { "noNonNullAssertion": "off" },
          "complexity": { "noExcessiveLinesPerFunction": "off" }
        }
      }
    }
  ]
}
