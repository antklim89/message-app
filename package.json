{
  "name": "message-app",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": ["apps/*", "packages/*"],
    "catalog": {
      "zod": "^4.6.7",
      "typescript": "^7.0.2",
      "@types/bun": "^1.4.4",
      "hono": "^4.13.16",
      "@trpc/server": "^11.22.1",
      "better-auth": "1.7.15",
      "next-themes": "^0.4.6",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "react-icons": "^5.7.0",
      "@trpc/client": "^11.22.1",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@types/node": "^26.6.6",
      "@chakra-ui/react": "^3.37.0",
      "@emotion/react": "^11.14.0",
      "npm-run-all2": "^9.0.4"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "check": "biome check --write .",
    "check-types": "turbo run check-types",
    "db:generate": "turbo run db:generate -F @message-app/db --",
    "db:migrate": "turbo run db:migrate -F @message-app/db --",
    "db:push": "turbo run db:push -F @message-app/db --",
    "db:studio": "turbo run db:studio -F @message-app/db --",
    "dev": "turbo run dev",
    "dev:server": "turbo run dev -F server --",
    "dev:web": "turbo run dev -F web --"
  },
  "dependencies": {
    "@message-app/env": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@message-app/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.14"
}
