{
  "name": "message-app",
  "type": "module",
  "license": "MIT",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "run-p dev:**",
    "dev:next": "bunx --bun vite --host 0.0.0.0 --port 3000",
    "dev:typecheck": "bun run typecheck",
    "build": "bunx --bun vite build",
    "start": "bunx --bun vite preview --host 0.0.0.0 --port 3000",
    "lint": "biome check",
    "typecheck": "tsc --noEmit -w --preserveWatchOutput -p tsconfig.app.json",
    "typegen": "supabase gen types --local > ./src/shared/model/supabase-types.generated.ts",
    "seed": "bun ./supabase/seed.ts",
    "dump": "bunx supabase db dump --local > supabase/dump.sql",
    "pull": "bunx supabase db pull --local",
    "docker:up": "docker compose up",
    "docker:start": "docker compose start",
    "docker:build": "docker compose build"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.34.0",
    "@emotion/react": "^11.14.0",
    "@lexical/react": "^0.42.0",
    "@supabase/supabase-js": "^2.101.1",
    "@tanstack/react-form": "^1.28.6",
    "@tanstack/react-query": "^5.96.0",
    "@tanstack/react-query-devtools": "^5.96.0",
    "@tanstack/react-router": "^1.168.10",
    "@tanstack/react-virtual": "^3.13.23",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "lexical": "^0.42.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-error-boundary": "^6.1.1",
    "react-icons": "^5.6.0",
    "supabase": "^2.84.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@faker-js/faker": "^10.4.0",
    "@tanstack/react-router-devtools": "^1.166.11",
    "@tanstack/router-plugin": "^1.167.12",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "globals": "^17.4.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
