{
  "name": "message-app",
  "type": "module",
  "license": "MIT",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "run-p dev:**",
    "dev:next": "bun --bun vite --host 0.0.0.0 --port 3000",
    "dev:typecheck": "bun run typecheck",
    "build": "bun --bun vite build",
    "start": "bun --bun vite preview --host 0.0.0.0 --port 3000",
    "lint": "biome check",
    "typecheck": "tsc --noEmit -w --preserveWatchOutput -p tsconfig.app.json",
    "typegen": "supabase gen types --local > ./src/shared/model/supabase-types.generated.ts",
    "seed": "bun --bun ./supabase/seed.ts",
    "dump": "bun supabase db dump --local > supabase/dump.sql",
    "pull": "bun supabase db pull --local",
    "docker:up": "docker compose up",
    "docker:start": "docker compose start",
    "docker:build": "docker compose build",
    "docker:push": "docker compose push"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@emotion/react": "^11.14.0",
    "@lexical/react": "^0.46.0",
    "@supabase/supabase-js": "^2.110.1",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-virtual": "^3.14.5",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "lexical": "^0.46.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-error-boundary": "^6.1.2",
    "react-icons": "^5.7.0",
    "supabase": "^2.109.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@faker-js/faker": "^10.5.0",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/router-plugin": "^1.168.19",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "globals": "^17.7.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.2",
    "vite": "^8.1.3",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
