{
  "name": "message-app",
  "type": "module",
  "license": "MIT",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "run-p dev:**",
    "dev:next": "bunx --bun vite --host 0.0.0.0 --port 3000",
    "dev:typecheck": "bun run typecheck",
    "build": "bunx --bun vite build",
    "start": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "biome check",
    "typecheck": "tsc --noEmit -w --preserveWatchOutput -p tsconfig.app.json",
    "typegen": "supabase gen types --local > ./src/shared/model/supabase-types.generated.ts",
    "dump": "bunx supabase db dump --local > supabase/dump.sql",
    "pull": "bunx supabase db pull --local"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.31.0",
    "@emotion/react": "^11.14.0",
    "@lexical/react": "^0.39.0",
    "@payloadcms/richtext-lexical": "^3.70.0",
    "@supabase/supabase-js": "^2.90.1",
    "@tanstack/react-form": "^1.27.7",
    "@tanstack/react-query": "^5.90.16",
    "@tanstack/react-query-devtools": "^5.91.2",
    "@tanstack/react-router": "^1.147.3",
    "@tanstack/react-virtual": "^3.13.18",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "lexical": "^0.39.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-error-boundary": "^6.0.3",
    "react-icons": "^5.5.0",
    "supabase": "^2.72.4",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@faker-js/faker": "^10.2.0",
    "@tanstack/react-router-devtools": "^1.147.3",
    "@tanstack/router-plugin": "^1.147.3",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "globals": "^17.0.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.4"
  }
}
